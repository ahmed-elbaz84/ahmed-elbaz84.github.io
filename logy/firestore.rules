rules_version = '2';
// Atelier Logy: only active shop members can read/write shop records; only managers delete or manage users.
// Record contents are encrypted on the device, so even the project owner sees only scrambled text.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(uid) { return /databases/$(database)/documents/members/$(uid); }
    function shopPath() { return /databases/$(database)/documents/meta/shop; }
    function isMember() { return signedIn() && exists(memberPath(request.auth.uid)) && get(memberPath(request.auth.uid)).data.active == true; }
    function isManager() { return isMember() && get(memberPath(request.auth.uid)).data.role == 'manager'; }
    // first-time setup: the very first account creates the shop and becomes its manager, in one batch
    function isFounding() {
      return signedIn() && !exists(shopPath())
        && getAfter(shopPath()).data.owner == request.auth.uid
        && getAfter(memberPath(request.auth.uid)).data.role == 'manager';
    }

    match /meta/shop {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && existsAfter(memberPath(request.auth.uid));
    }
    match /members/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if isManager() || (request.auth.uid == uid && isFounding());
      allow update: if isManager() && !(uid == request.auth.uid && request.resource.data.active == false);
    }
    match /keys/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if isManager() || (request.auth.uid == uid && isFounding());
      allow update: if signedIn() && request.auth.uid == uid && isMember();
    }
    match /recs/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['iv', 'e', 't', 'by']);
      allow delete: if isManager();
    }
  }
}
